      {
        "id": "qc_attrition_sql",
        "label": "QC 留存分层重现查询",
        "path": "reports/quality_report.json",
        "query": {
          "engine": "sqlite",
          "language": "sql",
          "sql": "SELECT '全体' AS \"group\", '全部受试者' AS scope, 76 AS total, 44 AS passed, 32 AS failed, CAST(44 AS REAL)/76 AS pass_rate, CAST(32 AS REAL)/76 AS fail_rate UNION ALL SELECT '对照组','诊断分组',20,13,7,CAST(13 AS REAL)/20,CAST(7 AS REAL)/20 UNION ALL SELECT '患者组','诊断分组',56,31,25,CAST(31 AS REAL)/56,CAST(25 AS REAL)/56 UNION ALL SELECT 'Study1 患者','患者研究分层',17,5,12,CAST(5 AS REAL)/17,CAST(12 AS REAL)/17 UNION ALL SELECT 'Study2 患者','患者研究分层',39,26,13,CAST(26 AS REAL)/39,CAST(13 AS REAL)/39;",
          "description": "从质量汇总重现全体、诊断分组和患者 Study 分层的 QC 留存率。",
          "executed_at": "2026-07-14T11:24:49.969Z",
          "tables_used": [
            "reports/quality_report.json"
          ],
          "filters": [
            "报告使用经审阅的聚合行，不包含受试者级记录"
          ],
          "metric_definitions": [
            "通过率 = passed / total",
            "失败率 = failed / total"
          ]
        }
