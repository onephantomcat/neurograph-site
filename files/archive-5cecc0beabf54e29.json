      {
        "id": "model_performance_sql",
        "label": "模型性能重现查询",
        "path": "reports/baseline_nested_cv.json",
        "query": {
          "engine": "sqlite",
          "language": "sql",
          "sql": "SELECT '年龄+性别' AS feature_set,'混杂对照' AS role,2 AS n_features,0.41770057899090157 AS auc_mean,0.057826671004163444 AS auc_sd,0.4855252274607113 AS balanced_accuracy,0.4838709677419355 AS sensitivity,0.4871794871794872 AS specificity,0.4069478908188585 AS ensemble_auc UNION ALL SELECT '扫描时间点','采集混杂诊断',1,0.6368899917287014,0.032880362630770814,0.7146401985111663,0.967741935483871,0.4615384615384615,0.5732009925558312 UNION ALL SELECT '功能连接 FC','影像探索',4005,0.7468982630272952,0.02367094792597879,0.7510339123242349,0.6559139784946236,0.8461538461538463,0.7568238213399504 UNION ALL SELECT '四类节点特征','影像探索',360,0.8155500413564929,0.01795081423838772,0.7671629445822994,0.6881720430107526,0.8461538461538461,0.8610421836228288 UNION ALL SELECT 'FC+节点特征','影像探索',4365,0.7427626137303557,0.04198855300743441,0.7307692307692308,0.6666666666666666,0.7948717948717948,0.7518610421836228;",
          "description": "从基线 JSON 重现五个特征组的 repeat-level OOF 主指标和次级集成 AUC。",
          "executed_at": "2026-07-14T11:24:49.969Z",
          "tables_used": [
            "reports/baseline_nested_cv.json"
          ],
          "filters": [
            "报告使用经审阅的聚合行，不包含受试者级记录"
          ],
          "metric_definitions": [
            "主 AUC = 3 次完整 OOF ROC AUC 的均值",
            "AUC SD = 3 次 OOF ROC AUC 的样本标准差",
            "平衡准确率 = (敏感度 + 特异度)/2"
          ]
        }
      },
      {
        "id": "quality_findings_sql",
        "label": "质量发现重现查询",
        "path": "reports/quality_report.json",
        "query": {
          "engine": "sqlite",
          "language": "sql",
          "sql": "SELECT 'P1' AS priority,'高' AS severity,'AAL90 覆盖/预处理失败' AS finding,'32/76 人失败（42.1%）；失败者 AAL116 零方差 ROI 为 32–80 个，中位数 53' AS evidence,'FC 非有限，静默补零会制造人工图结构' AS risk,'隔离输出中逐例检查配准、脑覆盖、掩膜并重跑失败者' AS action UNION ALL SELECT 'P1','高','Study 与 QC 留存相关','Study1 5/17 通过；Study2 26/39 通过','完整案例选择不是随机缺失，模型可能学习批次','补齐研究/扫描协议映射并做同协议或匹配敏感性分析' UNION ALL SELECT 'P1','高','采集长度与诊断纠缠','30/31 患者为 280 时间点；扫描时间点单特征 AUC 0.637±0.033','影像 AUC 不能归因于 OA 病理','加入运动、站点、协议等 nuisance；外部匹配验证' UNION ALL SELECT 'P1','高','缺少目标严重度标签','现有字段是治疗反应/VAS/WOMAC 改善，非神经病理性疼痛严重度','不能完成项目书中的疼痛智能分级结论','按项目书另建包含严重度金标准的前瞻性队列' UNION ALL SELECT 'P2','中','样本小且类别不平衡','最终 44 人：13 对照、31 患者','模型选择方差大，结果易乐观','固定外层 folds、预注册模型族，并扩大独立样本' UNION ALL SELECT 'P2','中','AAL116 小脑缺失需显式处理','12 名 AAL90 通过者仍有小脑零方差 ROI','AAL116 直接补零会改变边结构','AAL90 作为主分析；AAL116 仅作有记录的敏感性分析';",
          "description": "把已审阅的质量问题、证据、下游风险和整改动作整形成报告表。",
          "executed_at": "2026-07-14T11:24:49.969Z",
