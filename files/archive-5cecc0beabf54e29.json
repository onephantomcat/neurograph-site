          "sql": "SELECT '受试者 ID 唯一性' AS \"check\",'通过' AS result,'76/76 唯一' AS value,'每次构建强制唯一键' AS automation UNION ALL SELECT '元数据一致性','通过','0 个不一致','标签、年龄、性别跨源核对' UNION ALL SELECT '四类特征图完整性','通过','0 组缺失','fALFF/ALFF/ReHo/DC 文件与形状检查' UNION ALL SELECT 'FC 与 ROI 信号一致性','通过','0 个不一致','重算 AAL90 Fisher-Z FC，最大误差阈值 1e-8' UNION ALL SELECT '非有限值处理','通过','AAL90 数据全有限','禁止 NaN/Inf 静默插补' UNION ALL SELECT '输入溯源','通过','264 条 SHA-256 记录','路径、大小、mtime、SHA-256 固化' UNION ALL SELECT '自动测试','通过','19/19','真实数据只读契约测试';",
          "description": "重现独立复核中确认通过的工程完整性检查。",
