          "language": "sql",
          "sql": "SELECT '对照组' AS diagnosis,272 AS timepoints,0 AS subjects,13 AS accepted_total,0.0 AS share_within_diagnosis UNION ALL SELECT '对照组',275,6,13,CAST(6 AS REAL)/13 UNION ALL SELECT '对照组',280,7,13,CAST(7 AS REAL)/13 UNION ALL SELECT '患者组',272,1,31,CAST(1 AS REAL)/31 UNION ALL SELECT '患者组',275,0,31,0.0 UNION ALL SELECT '患者组',280,30,31,CAST(30 AS REAL)/31;",
          "description": "重现 44 名 AAL90 通过者按诊断组和扫描时间点的分布。",
